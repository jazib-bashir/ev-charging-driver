EXPO_PUBLIC_API_BASE_URL=https://ev-charging-backend-wwyk.onrender.com
# Required for Android Google Maps (native AndroidManifest). Must also be set in EAS
# project env for production builds — local .env is gitignored and not available on EAS.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=your-google-maps-map-id
