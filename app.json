{
  "expo": {
    "name": "konnectEVS",
    "slug": "ev-charging-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/konnectev-android-432.png",
    "scheme": "evchargingdriver",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D1117",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/brand/konnectev-android-432.png"
    },
    "android": {
      "package": "com.gridflow.driver",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#0D1117",
        "foregroundImage": "./assets/brand/konnectev-android-432.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "konnectEVS uses your location to show nearby charging stations and filter results by distance."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1117",
          "image": "./assets/splash/konnectev-splash-native.png",
          "resizeMode": "contain",
          "imageWidth": 288
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
