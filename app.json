{
  "expo": {
    "name": "GridFlow",
    "slug": "ev-charging-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-full.png",
    "scheme": "evchargingdriver",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5f7f9",
        "foregroundImage": "./assets/images/splash-full.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/splash-full.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f7f9",
          "image": "./assets/images/splash-full.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "ios": {
            "backgroundColor": "#f5f7f9",
            "image": "./assets/images/splash-full.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "backgroundColor": "#f5f7f9",
            "image": "./assets/images/splash-full.png",
            "resizeMode": "cover"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
